PORT=3000
NODE_ENV=development
HOST=127.0.0.1

# Create the database first, then set its connection URL.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/petty_cash_db?schema=public

# Generate two distinct values with: openssl rand -hex 32 (each is 64 characters)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Required only when creating missing seed users in production; use distinct values.
INITIAL_ADMIN_PASSWORD=
INITIAL_ACCOUNTANT_PASSWORD=
INITIAL_EMPLOYEE_PASSWORD=
INITIAL_BLUEKOM_EMPLOYEE_PASSWORD=

STORAGE_TYPE=local
UPLOAD_DEST=./uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=petty-cash-attachments
MINIO_USE_SSL=false
ALLOWED_ORIGINS=http://localhost:5173
