datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoleName {
  SUPER_ADMIN
  ACCOUNTANT
  EMPLOYEE
}

enum RequestStatus {
  DRAFT
  PENDING_APPROVAL
  ACCOUNTANT_REVIEW
  APPROVED
  REJECTED
  CORRECTION_REQUIRED
  PAYMENT_PROCESSING
  PAID
  COMPLETED
}

enum SettlementStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  EVC_PLUS
  EDAHAB
  ZAAD
  OTHER
}

enum Priority {
  LOW
  NORMAL
  MEDIUM
  HIGH
  URGENT
}

enum RequestType {
  CASH_ADVANCE
  CASH_SALES
  INVOICE_PAYMENT
  OFFICE_EXPENSE
  FUEL
  TRANSPORT
  MAINTENANCE
  UTILITIES
  PURCHASE
  EMERGENCY_EXPENSE
  OTHER
}

model Company {
  id        String    @id @default(uuid())
  name      String    @unique
  status    String    @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users               User[]
  departments         Department[]
  projects            Project[]
  regions             Region[]
  budgetHeads         BudgetHead[]
  pettyCashRequests   PettyCashRequest[]
  payments            Payment[]
  settlements         ExpenseSettlement[]
  pettyCashFunds      PettyCashFund[]
  ledgers             PettyCashLedger[]
}

model Role {
  id          String       @id @default(uuid())
  name        RoleName     @unique
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String           @id @default(uuid())
  action      String           // e.g., "CREATE", "READ", "APPROVE"
  subject     String           // e.g., "REQUEST", "USER", "REPORT"
  createdAt   DateTime         @default(now())
  
  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Department {
  id            String   @id @default(uuid())
  name          String
  companyId     String
  monthlyBudget Decimal? @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users     User[]
  requests  PettyCashRequest[]

  @@unique([name, companyId])
}

model Project {
  id          String   @id @default(uuid())
  name        String
  description String?
  companyId   String
  status      String   @default("ACTIVE") // ACTIVE, COMPLETED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests    PettyCashRequest[]

  @@unique([name, companyId])
}

model Region {
  id            String   @id @default(uuid())
  name          String
  companyId     String
  monthlyBudget Decimal? @default(0) @db.Decimal(12, 2)
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users     User[]
  requests  PettyCashRequest[]

  @@unique([name, companyId])
}

model BudgetHead {
  id            String   @id @default(uuid())
  code          String
  name          String
  description   String?
  companyId     String
  monthlyLimit  Decimal? @default(0) @db.Decimal(12, 2)
  status        String   @default("ACTIVE") // ACTIVE, INACTIVE
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests  PettyCashRequest[]

  @@unique([name, companyId])
  @@unique([code, companyId])
}

model User {
  id                    String        @id @default(uuid())
  fullName              String
  username              String        @unique
  passwordHash          String
  email                 String?
  phone                 String?
  employeeNumber        String        @unique
  companyId             String
  departmentId          String
  regionId              String?
  roleId                String
  status                String        @default("ACTIVE") // ACTIVE, DISABLED
  resetPasswordRequired Boolean       @default(true)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company               Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department            Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  region                Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  role                  Role          @relation(fields: [roleId], references: [id])
  
  requests              PettyCashRequest[] @relation("EmployeeRequests")
  paymentsMade          Payment[]     @relation("AccountantPayments")
  settlementsApproved   ExpenseSettlement[] @relation("SettlementApprover")
  refreshTokens         RefreshToken[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  ledgers               PettyCashLedger[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PettyCashRequest {
  id              String        @id @default(uuid())
  requestNumber   String        @unique // PC-YYYYMMDD-XXXX
  requestDate     DateTime      @default(now())
  userId          String
  companyId       String
  departmentId    String
  projectId       String?
  regionId        String?
  budgetHeadId    String?
  costCenter      String?
  requestType     RequestType   @default(OTHER)
  vendorName      String?
  invoiceNumber   String?
  invoiceDate     DateTime?
  remarks         String?
  purpose         String
  description     String?
  requestedAmount Decimal       @db.Decimal(12, 2)
  approvedAmount  Decimal?      @db.Decimal(12, 2)
  currency        String        @default("USD")
  priority        Priority      @default(NORMAL)
  status          RequestStatus @default(DRAFT)
  requiredDate    DateTime
  correctionNotes String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation("EmployeeRequests", fields: [userId], references: [id], onDelete: Cascade)
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department      Department    @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  project         Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  region          Region?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  budgetHead      BudgetHead?   @relation(fields: [budgetHeadId], references: [id], onDelete: SetNull)

  attachments     PettyCashAttachment[]
  payments        Payment[]
  settlements     ExpenseSettlement[]
  ledgers         PettyCashLedger[]
}

model PettyCashAttachment {
  id        String   @id @default(uuid())
  requestId String
  fileName  String
  fileUrl   String
  fileType  String
  fileSize  Int
  createdAt DateTime @default(now())

  request   PettyCashRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String        @id @default(uuid())
  requestId       String
  companyId       String
  paymentDate     DateTime      @default(now())
  amountPaid      Decimal       @db.Decimal(12, 2)
  paymentMethod   PaymentMethod
  transactionId   String?
  referenceNumber String?
  paidById        String
  notes           String?
  createdAt       DateTime      @default(now())

  request         PettyCashRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paidBy          User             @relation("AccountantPayments", fields: [paidById], references: [id])

  @@index([requestId])
  @@index([companyId])
  @@index([paidById])
}

model ExpenseSettlement {
  id                  String           @id @default(uuid())
  requestId           String
  companyId           String
  actualExpenseAmount Decimal          @db.Decimal(12, 2)
  remainingBalance    Decimal          @db.Decimal(12, 2)
  notes               String?
  status              SettlementStatus @default(PENDING)
  approvedById        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  request             PettyCashRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  approvedBy          User?            @relation("SettlementApprover", fields: [approvedById], references: [id])

  @@index([requestId])
  @@index([companyId])
  @@index([status])
}

model PettyCashFund {
  id                String   @id @default(uuid())
  companyId         String
  month             Int
  year              Int
  openingBalance    Decimal  @db.Decimal(12, 2)
  additionalFunding Decimal  @db.Decimal(12, 2)
  totalAvailable    Decimal  @db.Decimal(12, 2)
  approvedAmount    Decimal  @db.Decimal(12, 2) @default(0)
  paidAmount        Decimal  @db.Decimal(12, 2) @default(0)
  remainingBalance  Decimal  @db.Decimal(12, 2)
  closingBalance    Decimal? @db.Decimal(12, 2)
  status            String   @default("OPEN")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledgers           PettyCashLedger[]

  @@unique([companyId, month, year])
}

model PettyCashLedger {
  id              String        @id @default(uuid())
  fundId          String?
  companyId       String
  date            DateTime      @default(now())
  referenceNumber String?
  transactionType String
  employeeId      String?
  requestId       String?
  description     String
  debit           Decimal?      @db.Decimal(12, 2)
  credit          Decimal?      @db.Decimal(12, 2)
  balanceAfter    Decimal       @db.Decimal(12, 2)
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  fund            PettyCashFund?   @relation(fields: [fundId], references: [id], onDelete: SetNull)
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee        User?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  request         PettyCashRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
