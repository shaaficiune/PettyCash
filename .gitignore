# .gitignore — Petty Cash Management System

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
**/node_modules/

# ─── Build outputs ────────────────────────────────────────────────────────────
dist/
build/
.next/

# ─── Environment variables ────────────────────────────────────────────────────
# NEVER commit real .env files
.env
.env.local
.env.production
.env.staging
backend/.env
frontend/.env

# ─── Prisma ───────────────────────────────────────────────────────────────────
# Do commit: prisma/schema.prisma, prisma/seed.ts
# Don't commit generated client or migration lock
backend/prisma/dev.db

# ─── Uploads ──────────────────────────────────────────────────────────────────
backend/uploads/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
!.vscode/settings.json

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Coverage ─────────────────────────────────────────────────────────────────
coverage/

# ─── Docker ───────────────────────────────────────────────────────────────────
# Volume data should not be committed
postgres_data/
minio_data/
