# Copy to .env and fill in secrets before starting Docker Compose.
# Generate database/JWT secrets with: openssl rand -hex 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=petty_cash_db

# Compose builds its container URL from POSTGRES_USER/PASSWORD/DB.
# For running the backend directly on your machine, use localhost here.
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/petty_cash_db?schema=public

JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Distinct one-time passwords used only to create missing seed accounts.
INITIAL_ADMIN_PASSWORD=
INITIAL_ACCOUNTANT_PASSWORD=
INITIAL_EMPLOYEE_PASSWORD=
INITIAL_BLUEKOM_EMPLOYEE_PASSWORD=

STORAGE_TYPE=local
UPLOAD_DEST=./uploads
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=petty-cash-attachments
MINIO_USE_SSL=false

ALLOWED_ORIGINS=http://localhost:5173
