# ─── Server / Node ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# ⚠️  CHANGE THESE BEFORE DEPLOYING TO PRODUCTION
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Somtel@PL
POSTGRES_DB=petty_cash_db
DATABASE_URL="postgresql://postgres:Somtel%40PL@localhost:5432/petty_cash_db?schema=public"

# ─── JWT Secrets ──────────────────────────────────────────────────────────────
# ⚠️  REPLACE WITH STRONG RANDOM VALUES IN PRODUCTION
#     e.g. use: openssl rand -hex 64
JWT_SECRET=somtel_bluekom_petty_cash_secret_key_2026_jwt
JWT_REFRESH_SECRET=somtel_bluekom_petty_cash_refresh_secret_key_2026_jwt
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── File Storage ─────────────────────────────────────────────────────────────
# Use 'local' for development, configure MinIO/S3 for production
STORAGE_TYPE=local
UPLOAD_DEST=./uploads

# MinIO (S3-compatible) configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=petty-cash-attachments
